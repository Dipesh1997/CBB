<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 3D Closed Book Perspective - Spine -->
    <path
        android:fillColor="#7E5109"
        android:pathData="M28,32 L34,28 L34,76 L28,80 Z" />

    <!-- 3D Closed Book Perspective - Main Cover -->
    <path
        android:pathData="M34,28 L78,28 L78,76 L34,76 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="34"
                android:startY="28"
                android:endX="78"
                android:endY="76"
                android:type="linear">
                <item android:offset="0" android:color="#D4AC0D"/>
                <item android:offset="1" android:color="#9A7D0A"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3D Bottom Edge (Pages) -->
    <path
        android:fillColor="#BDC3C7"
        android:pathData="M28,80 L34,76 L78,76 L72,80 Z" />

    <!-- Glossy Cover Highlight -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.1"
        android:pathData="M34,28 L78,28 L78,32 L34,32 Z" />

    <!-- Plus Symbol (+) - Credit -->
    <path
        android:fillColor="#27AE60"
        android:pathData="M48,42 h4 v4 h4 v4 h-4 v4 h-4 v-4 h-4 v-4 h4 Z" />
    <!-- 3D Depth for Plus -->
    <path
        android:fillColor="#1E8449"
        android:pathData="M48,54 L52,54 L52,55 L48,55 Z" />

    <!-- Minus Symbol (-) - Debit -->
    <path
        android:fillColor="#E74C3C"
        android:pathData="M44,60 h12 v4 h-12 Z" />
    <!-- 3D Depth for Minus -->
    <path
        android:fillColor="#C0392B"
        android:pathData="M44,64 L56,64 L56,65 L44,65 Z" />

</vector>
